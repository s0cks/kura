{
  "name": "kura",
  "scopeName": "source.kura",
  "fileTypes": ["kui"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#primitive-types" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#identifiers" },
    {
      "name": "keyword.operator.assignment.kura",
      "match": "="
    },
    {
      "name": "keyword.operator.comparison.kura",
      "match": "==|!=|<=|>=|<|>"
    },
    {
      "name": "keyword.operator.pipeline.kura",
      "match": "\\|>"
    }
  ],
  "repository": {
    "primitive-types": {
      "name": "storage.type.primitive.kura",
      "match": "\\b(Seq|Int|String|Optional|Number)\\b"
    },
    "keywords": {
      "name": "keyword.control.kura",
      "match": "\\b(fn|if|else|type|None|match|for|fold|let|pub|use|as)\\b"
    },
    "comments": {
      "name": "comment.line.double-slash.kura",
      "begin": "//",
      "end": "$"
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.declaration.kura",
          "begin": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)\\b",
          "beginCaptures": {
            "1": { "name": "storage.type.function.kura" },
            "2": { "name": "entity.name.function.kura" }
          },
          "end": "(?==>|{)",
          "patterns": [
            { "include": "#comments" },
            { "include": "#type-annotations" },
            {
              "name": "variable.parameter.kura",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_-]*\\b"
            }
          ]
        }
      ]
    },
    "type-annotations": {
      "patterns": [
        {
          "begin": "(:)\\s*",
          "beginCaptures": {
            "1": { "name": "punctuation.separator.type.kura" }
          },
          "end": "(?=[,)]|=>|{)",
          "patterns": [
            {
              "name": "storage.type.kura",
              "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
            }
          ]
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.numeric.kura",
          "match": "\\b[0-9]+(fr|pct|px)?\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.kura",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.kura",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.kura",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_-]*\\b"
        }
      ]
    }
  }
}
