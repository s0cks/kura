{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 29,
    "patch": 3
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        },
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_STANDARD": "23",
        "CMAKE_C_STANDARD_REQUIRED": "ON",
        "VCPKG_APPLOCAL_DEPS": "ON",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON"
      }
    },
    {
      "name": "base-clang",
      "hidden": true,
      "inherits": ["base"],
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Debug (Clang)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": {
          "value": "Debug",
          "type": "STRING"
        }
      },
      "environment": {
        "BUILD_ENVIRONMENT": "dev"
      },
      "inherits": ["base-clang"]
    },
    {
      "name": "clang-llvm20-debug",
      "displayName": "Debug (Clang, LLVM 20)",
      "binaryDir": "${sourceDir}/build-llvm20",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": {
          "value": "Debug",
          "type": "STRING"
        },
        "KURA_LLVM_VERSION": {
          "value": "20",
          "type": "STRING"
        }
      },
      "environment": {
        "BUILD_ENVIRONMENT": "dev"
      },
      "inherits": ["base-clang"]
    }
  ],
  "buildPresets": [
    {
      "name": "clang-debug",
      "displayName": "Debug (Clang)",
      "configurePreset": "clang-debug"
    },
    {
      "name": "clang-llvm20-debug",
      "displayName": "Debug (Clang, LLVM 20)",
      "configurePreset": "clang-llvm20-debug"
    }
  ]
}
