fn int(): Int => 10
fn float(): Float => 10.5
fn negative(): Int => -3
fn negative-float(): Float => -0.25
fn unit(): Px => 10px
fn widen(a: Int): Number => a
fn classify(n: Int): String =>
  match n {
    10 => "ten",
    -1 => "negative one",
    _ => "other",
  }
fn classify-float(x: Float): String =>
  match x {
    1.5 => "one and a half",
    _ => "other",
  }
