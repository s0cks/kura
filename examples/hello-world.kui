fn init() => { message: "Hello World"  }

fn view(count: Int, test: Bool): Node => {
  let text = if count > 1 { "Done" } else { "Hello World" }
  #block(direction: "column",
         fill: white,
         radius: 16px,
         width: 1fr,
         height: 1fr,
         padding: 10px,
         gap: 10px){
    "Hello World"
    "Done"
  }
}
