fn init() => { message: "Hello World"  }

fn view(count: Int, test: Bool): Node => {
  let text = if count > 1 { "Done" } else { "Hello World" }
  #block(direction: "column",
         fill: white,
         radius: 16px,
         width: 1fr,
         height: 1fr,
         padding: 10px,
         gap: 10px){
    #block(direction: "row",
           justify: "center",
           height: 1fr,
           fill: black,
           gap: 32px,
           padding: 20px){
      #button(fill: red, shrink: 1, grow: 0){
        #text(text)
      }

      #button(fill: blue){
        #text("Close")
      }

      #button(fill: green, grow: 1){
        #text("Close")
      }

      #button(fill: blue){
        #text("Close")
      }
    }
  }
}
