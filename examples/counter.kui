type Message = Increment | Decrement | Reset | Set(Int) | Resized(Size) | Append(Int)

type State = {
  value: Int,
  width: Float,
  height: Float,
  items: Seq<String>,
}
 
fn init(): State =>
  {
    value: 1,
    width: 0.0,
    height: 0.0,
    items: [  ],
  }

fn update(msg: Message, state: State): State =>
  match msg {
    Increment =>
      {
        value: state.value + 1,
        width: state.width,
        height: state.height,
        items: state.items,
      }
    Decrement =>
      {
        value: state.value - 1,
        width: state.width,
        height: state.height,
        items: state.items,
      }
    Reset =>
      {
        value: 0,
        width: state.width,
        height: state.height,
        items: [ ],
      }
    Set(n) =>
      {
        value: n,
        width: state.width,
        height: state.height,
        items: state.items,
      }
    Resized(size) =>
      {
        value: state.value,
        width: size.width,
        height: size.height,
        items: state.items,
      }
    Append(n) => 
      {
        value: state.value,
        width: state.width,
        height: state.height,
        items: state.items + [ "{n}"],
      }
    _ => state
  }

fn counter-buttons() =>
  set text(size: 24px, 
           text-align: "center")
  set button(justify: "center", padding: 16px, fill: white)
  #fragment{
    #button(on-click: Increment){
      #text("Increment")
    }

    #button(on-click: Decrement){
      #text("Decrement")
    }
  }


fn row(label: String) =>
  set text(size: 24px)
  #block(direction: "row", justify: "center", padding: 4px, fill: white){
    #text(label)
  }

fn view(state: State): Node => {
  set text(size: 24px)
  set button(justify: "center", padding: 16px, fill: white)

  let wide = state.width > 700.0
  #block(direction: "column",
         justify: "center",
         width: 1fr,
         height: 1fr,
         padding: 10px,
         gap: 10px,
         fill: match state.value {
                n if n > 0 => green,
                n if n < 0 => red,
                _ => white,
              }){
    #block(direction: "column",
           grow: 1,
           justify: "center"){
      #block(direction: "row",
             justify: "center"){
        #text("value: {state.value}")
      }

      #button(on-click: Append(state.value)){
        #text("Append")
      }

      counter-buttons()
    }

    #scroll(){
      #list(){
        for _, item in state.items =>
          row(item)
      }
    }
  }
}
