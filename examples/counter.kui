type Message = Increment | Decrement | Reset | Set(Int) | Resized(Size) | Append(Int)

type State = {
  value: Int,
  width: Float,
  height: Float,
  items: Seq<String>,
}
 
fn init(): State =>
  {
    value: 1,
    width: 0.0,
    height: 0.0,
    items: [  ],
  }

fn update(msg: Message, state: State): State =>
  match msg {
    Increment => { state | value += 1 }
    Decrement => { state | value -= 1 }
    Reset => { state | value: 0, items: [] }
    Set(n) => { state | value: n }
    Resized(size) =>
      {
        state |
        width: size.width,
        height: size.height,
      }
    Append(n) => { state | items += [ "{n}"] }
    _ => state
  }

fn counter-buttons() =>
  set text(size: 24px, 
           text-align: "center")
  set button(justify: "center", padding: 16px, fill: white)
  #fragment{
    #button(on-click: Increment, border){
      #text("Increment")
    }

    #button(on-click: Decrement){
      #text("Decrement")
    }
  }


fn row(label: String) =>
  set text(size: 24px)
  #block(direction: "row", justify: "center", padding: 4px, fill: white){
    #text(label)
  }

fn view(state: State): Node => {
  set text(size: 24px)
  set button(justify: "center", padding: 16px, fill: white)
  set block(gap: 16px, padding: 32px, justify: "center")

  #block(direction: "column",
         width: 1fr,
         height: 1fr,
         fill: match state.value {
                n if n > 0 => green,
                n if n < 0 => red,
                _ => white,
              }){
    #block(direction: "column",
           grow: 1){
      #block(direction: "row"){
        #text("value: {state.value}")
      }

      #button(on-click: Append(state.value)){
        #text("Append")
      }

      counter-buttons()
    }

    #list(){
      for _, item in state.items =>
        row(item)
    }
  }
}
