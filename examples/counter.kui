type Message = Increment | Decrement | Reset | Set(Int) | Resized(Size) | Append(Int) | InitValue(String)

type State = {
  value: Int,
  width: Float,
  height: Float,
  items: Seq<String>,
  message: String,
}
 
fn init(): State =>
  {
    value: 1,
    width: 0.0,
    height: 0.0,
    items: [  ],
    message: "",
  }

fn update(msg: Message, state: State): State =>
  match msg {
    Increment => { state | value += 1 }
    Decrement => { state | value -= 1 }
    Reset => { state | value: 0, items: [] }
    Set(n) => { state | value: n }
    Resized(size) =>
      {
        state |
        width: size.width,
        height: size.height,
      }
    InitValue(t) => { state | message: t, }
    Append(n) => { state | items += [ "{n}"] }
    _ => state
  }

fn counter-buttons() =>
  set text(size: 24px, 
           text-align: "center")
  set button(justify: "center", padding: 16px, fill: white, radius: 16px)
  #fragment{
    #button(on-click: Increment){
      #text("Increment")
    }

    #button(on-click: Decrement){
      #text("Decrement")
    }
  }


fn row(label: String) =>
  set text(size: 24px)
  #block(direction: "row", justify: "center", padding: 4px, fill: white){
    #text(label)
  }

fn view(state: State): Node => {
  set text(size: 24px)
  set button(justify: "center", padding: 16px, fill: white)
  set block(gap: 16px, padding: 32px, justify: "center")
  set line(fill: blue)

  #block(direction: "column",
         width: 1fr,
         height: 1fr,
         fill: match state.value {
                n if n > 0 => green,
                n if n < 0 => red,
                _ => white,
              }){
    #block(direction: "column",
           min-height: 25%,
           grow: 1){
      #input(size: 24px, placeholder: "Init value...", on-input: InitValue, state.message)

      #block(direction: "row"){
        #text("{10} value: {state.value} {11}")
      }

      #line

      #button(on-click: Append(state.value), radius: 16px){
        #text("Append")
      }

      #line

      counter-buttons()
    }

    #block(direction: "row", max-height: 75%){
      #scroll{
        #list{
          for _, item in state.items =>
            row(item)
        }
      }
    }
  }
}
