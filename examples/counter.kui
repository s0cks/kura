type Message = Increment | Decrement | Reset | Set(Int) | Resized(Size) | Append(Int) | InitValue(String)

type State = {
  value: Int,
  width: Float,
  height: Float,
  items: Seq<String>,
  message: String,
}
 
fn init(): State =>
  {
    value: 1,
    width: 0.0,
    height: 0.0,
    items: [  ],
    message: "",
  }

fn update(msg: Message, state: State): State =>
  match msg {
    Increment => { state | value += 1 }
    Decrement => { state | value -= 1 }
    Reset => { state | value: 0, items: [] }
    Set(n) => { state | value: n }
    Resized(size) =>
      {
        state |
        width: size.width,
        height: size.height,
      }
    InitValue(t) => { state | message: t, }
    Append(n) => { state | items += [ "{n}"] }
    _ => state
  }

fn counter-buttons() =>
  set text(size: 24px, 
           text-align: "center")
  set button(justify: "center", padding: 16px, fill: white, radius: 16px)

  #fragment{
    #button(on-click: Increment){
      #text("Increment")
    }

    #button(on-click: Decrement){
      #text("Decrement")
    }
  }


fn row(label: String) =>
  set text(size: 24px)

  #block(width: 100%, direction: "row", justify: "center", padding: 4px){
    #text(label)
  }

fn view(state: State): Node => {
  set text(size: 24px)
  set button(justify: "center", padding: 16px, fill: white, radius: 16px)
  set block(gap: 16px, padding: 32px, justify: "center")
  set line(fill: blue)

  #block(direction: "column",
         width: 1fr,
         height: 1fr,
         fill: match state.value {
                n if n > 0 => green,
                n if n < 0 => red,
                _ => white,
              }){
    #block(direction: "column",
           height: 40%,
           min-height: 40%,
           shrink: 1){
      #block(direction: "row", gap: 16px){
        #input(size: 24px, grow: 1, placeholder: "Init value...", on-input: InitValue, state.message)

        #button(shrink: 0){
          #text("Set")
        }
      }

      #block(direction: "row"){
        #text("{10} value: {state.value} {11}")
      }

      #line

      #button(on-click: Append(state.value)){
        #text("Append")
      }

      #line

      counter-buttons()
    }

    #block(direction: "column", height: 60%, min-height: 30%, grow: 1){
      #scroll(width: 100%){
        #block(direction: "column"){
          #list(width: 100%){
            for _, item in state.items =>
              row(item)
          }
        }
      }
    }
  }
}
