fn x2(x: Number): Number => x * 2

fn size(n: Number): Number =>
  if n > 10 { 3 } else if n > 5 { 2 } else { 1 }

test "test size" {
  assert(size(0) == 1)
  assert(size(1) == 1, "expected size(1) to equal 1")
  assert(size(6) == 2, "expected size(6) to equal 2")
}

@should-fail
test "test failure" {
  assert(1 == 0)
}
