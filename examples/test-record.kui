fn init() =>
  {
    count: 0,
    message: "Hello World",
  }

fn init2() => 
  {
    count: 10 + 10,
    message: "Hello World",
  }

fn init3(x) =>
  if x == 10 {
    {
      count: 0,
      message: "Hello World",
    }
  } else {
    {
      count: x + 10,
      message: "Hello World",
    }
  }

fn init4() =>
  {
    count: 0,
  } +
  {
    message: "Hello World",
  }
