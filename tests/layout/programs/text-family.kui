// args: 1
// A text sits at its box's top-left, inside the padding of the block, in the font family it names (the
// default font when it names none). The fixed model of the headless renderer makes "hello" at 20px
// 5 * 10 = 50 wide and 25 tall, and "plain" at 10px 25 wide.
fn view(n: Int): Node =>
  #block(padding: 10px, width: 200px, height: 100px, align: "start", fill: white) {
    #text(value: "hello", size: 20px, font-family: "Inter, sans-serif", color: red)
    #text(value: "plain", size: 10px)
  }
