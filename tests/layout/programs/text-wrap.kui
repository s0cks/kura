// args: 1
// The block leaves 80px of room (100 less 10 of padding on each side), and at 20px each letter is 10px, so
// "aaa bbb ccc" (110px) breaks after "bbb" and is drawn as two lines of 25px, as layout measured it.
fn view(n: Int): Node =>
  #block(padding: 10px, width: 100px, height: 100px, align: "start", fill: white) {
    #text(value: "aaa bbb ccc", size: 20px)
  }
