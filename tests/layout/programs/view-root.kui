// args: 0
// An explicit #view: its padding is the window's, and its fill paints all of it.
type Message = Tick | Tock
fn init(): Int => 0
fn update(msg: Message, state: Int): Int => state

fn view(state: Int): Node =>
  #view(fill: white, padding: 8px, direction: "column", gap: 4px){
    #text("a")
    #block(fill: red, height: 10px)
  }
