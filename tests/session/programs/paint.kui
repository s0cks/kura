// One box, or one text, for each of the properties that make a box more than a rectangle.
type Message = Tick | Tock

fn init(): Int => 0
fn update(msg: Message, state: Int): Int => state

fn view(state: Int): Node =>
  #block(direction: "column", gap: 4px, width: 100px){
    #block(width: 20px, height: 10px, fill: red, radius: 4px)
    #block(width: 20px, height: 10px, fill: white, border-width: 2px, border-color: blue)
    #block(width: 20px, height: 10px, fill: green, opacity: 0.5)
    #block(width: 20px, height: 10px, border-color: red)
    #block(width: 20px, height: 10px, border-width: 3px)
    #block(width: 20px, height: 10px, fill: red, opacity: 0.0)
    #text(opacity: 0.5, "faded")
    #text(text-align: "left", "start")
    #text(text-align: "center", "middle")
    #text(text-align: "right", "end")
    #scroll(width: 20px, height: 10px, fill: red, radius: 3px){ #text("s") }
  }
