// Nested control flow: the phi of an outer `if` must take its incoming block
// from the end of an arm that itself contains control flow.
fn nested-if(a: Bool, b: Bool): Number =>
  if a {
    if b { 1 } else { 2 }
  } else {
    3
  }

fn chain(n: Number): Number =>
  if n > 10 { 3 } else if n > 5 { 2 } else if n > 0 { 1 } else { 0 }

fn short-circuit(a: Bool, b: Bool, c: Bool): Bool => a && b || !c

fn if-in-operand(a: Bool, n: Number): Number => (if a { n } else { 0 }) + 1

fn match-in-if(a: Bool, n: Number): Number =>
  if a {
    match n {
      0 => 10,
      1 => 20,
      _ => 30,
    }
  } else {
    0
  }

fn if-in-match(n: Number, a: Bool): Number =>
  match n {
    0 => if a { 1 } else { 2 },
    _ => 3,
  }
