let base = 10

fn apply(op: (Number, Number) => Number, a: Number, b: Number): Number => op(a, b)

fn no-capture(x: Number): Number => apply((a, b) => a + b, x, 1)
fn capture(k: Number): Number => apply((a, b) => a * k + b, 3, 4)
fn capture-two(k: Number, j: Number): Number => apply((a, b) => a * k + b * j, 3, 4)

// the inner lambda reads `x` from the outer lambda and `k` from the function
fn nested(k: Number): Number => ((x) => ((y) => x + y + k)(2))(1)

fn curry(a: Number) => (b) => a + b
fn use-curry(): Number => curry(1)(2)

// module-level bindings are read from memory, not captured
fn add-base(x: Number): Number => x + base
fn lambda-global(x: Number): Number => apply((a, b) => a + b + base, x, 1)

fn capture-loop-var(numbers: Seq<Number>, k: Number): Seq<Number> =>
  for n in numbers => apply((a, b) => a + b, n, k)
