// run: ints 7 2 => 17
fn ints(a: Int, b: Int): Int => a * b + a / b
// run: truncating -7 2 => -3
fn truncating(a: Int, b: Int): Int => a / b
// run: wraps => -9223372036854775808
fn wraps(): Int => 9223372036854775807 + 1
// run: floats 3.0 2.0 => 7.5
fn floats(a: Float, b: Float): Float => a * b + a / b
// run: literals => 3.0
fn literals(): Float => 1.5 * 2.0
// run: negate 3 2.5 => -1.5
fn negate(a: Int, b: Float): Float => -b + 1.0
// run: negate-int 5 => -5
fn negate-int(a: Int): Int => -a
// run: compare 1 2 => true
// run: compare 2 1 => false
// run: compare 0 0 => true
fn compare(a: Int, b: Int): Bool => a < b && a != b || a == 0
// run: scale 10px 3 => 55px
fn scale(a: Px, k: Int): Px => a * k + a / 2 + 2 * a
// run: ratio 10px 4px => 2.5
fn ratio(a: Px, b: Px): Float => a / b
// run: same-unit 3px 2px => true
fn same-unit(a: Px, b: Px): Bool => a + b > a - b
// run: percent 25% => 50%
fn percent(a: Pct): Pct => a * 2.0
// run: number 1 2 => 3
// run: number-twice 1.5 => 3.0
// run: number-twice 2 => 4
fn number(a: Number, b: Int): Number => a + b
fn number-twice(a: Number): Number => a + a
// run: pass-int 4 => 5
fn pass-int(a: Int): Number => number(a, 1)
// run: mixed-branches true => 1
// run: mixed-branches false => 1.5
fn mixed-branches(a: Bool): Number => if a { 1 } else { 1.5 }
// run: join => "ab"
fn join(): String => "a" + "b"
// run: order apple banana => true
// run: order b a => false
fn order(a: String, b: String): Bool => a < b
// run: str-eq a a => true
fn str-eq(a: String, b: String): Bool => a == b
